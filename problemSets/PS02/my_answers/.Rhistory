#function
calculate_median <- function(a) {
a <- sort(a)
n <- length(a)
m <- (n + 1) %/% 2
if (n %% 2 == 1) {
med <- a[m] # For odd, median = m
} else {
#browser() #pauses the function for debugging
med <- mean(a[m:m+1]) # bug a
#For even, median should be average but theres operator precedence issue here
}
return(med)
}
debugonce(calculate_median)
calculate_median(v2)
