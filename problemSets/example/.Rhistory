## 1.1 90% CI for average student IQ ##
# Determine average (mean) and variance (with standard deviation) student IQ in sample
sample_mean <- mean(y)
sample_sd <- sd(y)
?se
?se()
## 1.1 90% CI for average student IQ ##
# Determine average (mean) and variance (with standard deviation) student IQ in sample
n <- length(y)
sample_se <- (sample_sd / sqrt(n))
standard_error <- (sample_sd / sqrt(n))
# Find critical t value (since n)
t90 <-
?qt()
?qt()
# Find critical t value (since n)
t90 <- qt((1-.90) / 2), lower.tail = FALSE)
# Find critical t value (since n)
t90 <- qt((1-.90) / 2) lower.tail = FALSE)
# Find critical t value (since n)
t90 <- qt(((1-.90) / 2 ), lower.tail = FALSE)
# Find critical t value (since n)
t90 <- qt(n - 1, ((1-.90) / 2 ), lower.tail = FALSE)
df <- n - 1
# Find critical t value (since n)
t90 <- qt(df, ((1-.90) / 2 ), lower.tail = FALSE)
# Find critical t value (since n)
t90 <- qt(24, ((1-.90) / 2 ), lower.tail = FALSE)
t90 <- qt(.90, 24)
# FInd upper and lower limits of CI, mean +/- margin of error
lower_90 <- sample_mean - (t90 * standard_error)
upper_90 <- sample_mean + (t90 * standard_error)
confint_90 <- c(lower_90, upper_90)
confint()
confint_90
?confint()
confint.lm(y, level = .90)
confint.lm(y, sample_mean, level = .90)
