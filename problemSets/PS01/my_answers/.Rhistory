# Function composing
# By nesting function calls
x <- runif(100)
sqrt(mean(square(deviation(x))))
deviation <- function(x) x- mean(x)
# Function composing
square <- function(x) x^2
sqrt(mean(square(deviation(x))))
out <- deviation(x)
out <- square(out)
out <- mean(out)
out <- sqrt(out)
out
