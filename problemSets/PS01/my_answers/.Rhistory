# Be careful when writing 1:length(x)
means <- c()
# vector() function is useful for initialising empt vectors of known type and length
out <- vector(mode = "list", length = length(means)) #designate output variable
for (i in 1:length(means)) {
out[[i]] <- rnorm(10, means[[1]])
}
out <- vector(mode = "list", length = length(means)) #designate output variable
for (i in 1:seq_along(means)) {
out[[i]] <- rnorm(10, means[[1]])
}
for (i in 1:seq_along(means)) {
out[[i]] <- rnorm(10, means[[i]])
}
# vector() function is useful for initialising empty vectors of known type and length
#out <- vector(mode = "list", length = length(means)) #designate output variable
#for (i in 1:length(means)) {
#  out[[i]] <- rnorm(10, means[[1]])
#}
#get error as iterate from 1:0 which breaks when it goes means to i
# as : works with both increasing and decresing
# instead use seq_along(means) . Takes object and create sequence for elements in that object
means <- c()
out <- vector(mode = "list", length = length(means)) #designate output variable
for (i in 1:seq_along(means)) {
out[[i]] <- rnorm(10, means[[i]])
}
for (i in seq_along(means)) {
out[[i]] <- rnorm(10, means[[i]])
}
