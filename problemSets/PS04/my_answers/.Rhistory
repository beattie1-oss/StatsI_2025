Prestige$prof <- ifelse(Prestige$type =="prof", 1, 0)
#new var, if 'prof' in type then 1 else 0 for blue/white collar workers
# Q1 b)
model1 <- lm(prestige ~ income + prof + income:prof, data = Prestige)
