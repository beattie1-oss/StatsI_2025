pdf("PS04_regplot.pdf")
ggplot(data = Prestige, aes(x = income, y = prestige, colour = prof)) +
geom_point(size = 1) +
scale_x_continuous(limits = c(0, NA)) +
geom_abline(intercept = 58.923, slope = 0.001, colour = "#00BFC4", size = 0.75) +
geom_abline(intercept = 21.142, slope = 0.003, colour = "#F8766D", size = 0.75) +
labs(x = "Income", y = "Prestige", colour = "Job type") +
theme_light() +
theme(panel.grid = element_blank(),
panel.border = element_rect(colour = "black", fill = NA, size = 1)
legend.position = c(0.8, 0.2),
