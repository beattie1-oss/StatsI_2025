#create matrices
X <- as.matrix(cbind(rep(1,dim(inputDF)[1]), inputDF[ , covariates])))
#create matrices
X <- as.matrix(cbind(rep(1,dim(inputDF)[1]), inputDF[ , covariates]))
#create variance-covariance matrix for betas
var_covar_mat <- sigma_squared*solve(t(X)%*%X)
